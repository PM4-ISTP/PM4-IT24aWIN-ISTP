# =============================================================================
# Frontend Local Development Environment Variables
#
# Copy this file to `.env.local` and fill in the values:
#   cp .env.example .env.local
#
# `.env.local` is gitignored and must never be committed.
# =============================================================================

# -----------------------------------------------------------------------------
# NextAuth
# -----------------------------------------------------------------------------

# URL of this Next.js app — keep localhost:3000 for local development.
NEXTAUTH_URL=http://localhost:3000

# Random secret used to sign the NextAuth session cookie.
# Generate one with:  openssl rand -base64 32
NEXTAUTH_SECRET=

# -----------------------------------------------------------------------------
# Keycloak — Staging
#
# Connect to the shared staging Keycloak so you don't need to run it locally.
# The client secret can be found in the Keycloak admin console under:
#   Clients → interactive-security-training-platform-app → Credentials
# -----------------------------------------------------------------------------

AUTH_KEYCLOAK_ISSUER=https://istp-staging-auth.pm4.init-lab.ch/realms/interactive-security-training-platform
AUTH_KEYCLOAK_ID=interactive-security-training-platform-app
AUTH_KEYCLOAK_SECRET=

# Optional: URL for the Keycloak admin console used by the admin dashboard link.
KEYCLOAK_ADMIN_URL=https://istp-staging-auth.pm4.init-lab.ch/admin/interactive-security-training-platform/console/

# -----------------------------------------------------------------------------
# Backend API URL
#
# Option A — local backend (default):
#   BACKEND_URL=http://localhost:8080
#
# Option B — staging backend (use when you only need to change the frontend):
#   BACKEND_URL=https://istp-staging.pm4.init-lab.ch
# -----------------------------------------------------------------------------

BACKEND_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# Logout Redirect (optional)
#
# If unset, the logout route falls back to NEXTAUTH_URL.
# -----------------------------------------------------------------------------

# AUTH_POST_LOGOUT_REDIRECT_URI=http://localhost:3000

# -----------------------------------------------------------------------------
# Playwright E2E Tests (optional)
#
# Credentials for a dedicated Keycloak user used in E2E tests.
# Keep real shared credentials in `.env.local` or CI secrets, never in this example file.
# Especially never set the password in this file. Username is ok, because it is not a secret.
# In CI, set these via the E2E_{ROLE}_USERNAME and E2E_{ROLE}_PASSWORD secrets.
# If you do not set a value, the given default values will be used.
# -----------------------------------------------------------------------------

# E2E_ADMIN_USERNAME=e2e-admin
# E2E_ADMIN_PASSWORD=e2e-admin

# E2E_INSTRUCTOR_USERNAME=e2e-instructor
# E2E_INSTRUCTOR_PASSWORD=e2e-instructor

# E2E_INSTRUCTOR_WITHOUT_COURSES_OR_LABS_USERNAME=e2e-instructor-without-courses-or-labs
# E2E_INSTRUCTOR_WITHOUT_COURSES_OR_LABS_PASSWORD=e2e-instructor-without-courses-or-labs

# E2E_STUDENT_USERNAME=e2e-student
# E2E_STUDENT_PASSWORD=e2e-student