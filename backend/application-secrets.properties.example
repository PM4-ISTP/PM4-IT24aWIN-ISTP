# Local-only backend configuration (DO NOT COMMIT real values)
#
# Copy this file to `backend/application-secrets.properties` and fill in values:
#   cp application-secrets.properties.example application-secrets.properties
#
# Spring Boot loads it via `spring.config.import` in `backend/src/main/resources/application.properties`.

# -----------------------------------------------------------------------------
# Database (local Docker Compose)
# -----------------------------------------------------------------------------

# JDBC URL of the local Postgres started via `infra/docker-compose.yaml`.
# (Default in application.properties: jdbc:postgresql://localhost:5432/postgres)
# DB_URL=jdbc:postgresql://localhost:5432/postgres

# Database username (default: postgres)
# DB_USERNAME=postgres

# Database password (must match `infra/.env` -> POSTGRES_PASSWORD).
DB_PASSWORD=

# Optional: if you prefer the standard Spring variable name, you can set this instead of DB_PASSWORD.
# SPRING_DATASOURCE_PASSWORD=

# -----------------------------------------------------------------------------
# Keycloak — Staging (remote; no local Keycloak)
# -----------------------------------------------------------------------------

# JWT issuer URL used to validate access tokens (default points to staging).
# SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=https://istp-staging-auth.pm4.init-lab.ch/realms/interactive-security-training-platform

# Base URL for the Keycloak Admin REST API (default points to staging).
# KEYCLOAK_ADMIN_BASE_URL=https://istp-staging-auth.pm4.init-lab.ch

# Service-account client secret for `istp-backend` (required only for admin/profile sync features).
KEYCLOAK_ADMIN_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Misc app settings (optional)
# -----------------------------------------------------------------------------

# Hibernate DDL mode (local default: update). For production you typically want validate + migrations.
# HIBERNATE_DDL_AUTO=update

# CORS allowed origin for the frontend dev server (default: http://localhost:3000).
# CORS_ALLOWED_ORIGIN=http://localhost:3000

# UserInfo enrichment (only needed when required claims are missing in JWTs).
# ISTP_USERINFO_ENABLED=true
# ISTP_USERINFO_TIMEOUT=2s

# -----------------------------------------------------------------------------
# Lab Pods / K8s (optional; only if you use the in-cluster lab environment locally)
# -----------------------------------------------------------------------------

# KUBERNETES_NAMESPACE=default
# ISTP_DOMAIN=127.0.0.1.nip.io
# ISTP_TLS=false
