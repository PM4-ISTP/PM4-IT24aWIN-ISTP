# Local development overrides (DO NOT COMMIT real secrets)
#
# Copy this file to `backend/src/main/resources/application-local.properties` and fill in secrets:
#   cp application-local.properties.example src/main/resources/application-local.properties
#
# Run with:
#   - Git Bash:   SPRING_PROFILES_ACTIVE=local ./gradlew bootRun
#   - PowerShell: $env:SPRING_PROFILES_ACTIVE="local"; .\gradlew.bat bootRun

# Local Postgres (infra/docker-compose.yaml)
spring.datasource.url=jdbc:postgresql://localhost:5432/postgres
spring.datasource.username=postgres
spring.datasource.password=root

# Local-friendly defaults
cors.allowed-origin=http://localhost:3000
spring.jpa.hibernate.ddl-auto=update

# Keycloak (remote staging; no local Keycloak)
spring.security.oauth2.resourceserver.jwt.issuer-uri=https://istp-staging-auth.pm4.init-lab.ch/realms/interactive-security-training-platform
keycloak.admin.base-url=https://istp-staging-auth.pm4.init-lab.ch
keycloak.admin.client-secret=6NFk01WRXj3BYiFICVKZFiyWKp2zojs8
