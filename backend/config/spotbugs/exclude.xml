<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter
    xmlns="https://github.com/spotbugs/filter/3.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0
        https://raw.githubusercontent.com/spotbugs/spotbugs/master/spotbugs/etc/findbugsfilter.xsd">

    <!--
        Lombok @Data / @Value generates getters that return direct references to
        mutable internal arrays or collections. SpotBugs flags these as
        EI_EXPOSE_REP (return) / EI_EXPOSE_REP2 (store from parameter).
        These are acceptable in typical domain/DTO classes.
    -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!--
        Spring @Autowired / @Value fields appear unwritten from SpotBugs' static
        perspective because injection happens at runtime via reflection.
    -->
    <Match>
        <Bug pattern="UWF_UNWRITTEN_FIELD"/>
    </Match>

    <!--
        Spring Boot's @SpringBootApplication main() method is a conventional
        entry point; SpotBugs static field write warnings here are not actionable.
    -->
    <Match>
        <Bug pattern="ST_WRITE_TO_STATIC_FROM_INSTANCE_METHOD"/>
    </Match>

</FindBugsFilter>
