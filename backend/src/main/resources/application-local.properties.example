# Local-only secrets (DO NOT COMMIT real secrets)
#
# Usage:
# - Copy to `application-local.properties`
# - Fill in `keycloak.admin.client-secret`
#
# This file is safe to commit; the real `application-local.properties` should NOT be committed.

# Keycloak Admin API service account secret for client `istp-backend`
keycloak.admin.client-secret=

