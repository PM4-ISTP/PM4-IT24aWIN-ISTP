# Local PostgreSQL used by Docker Compose (infra/)
#
# Copy this file to `infra/.env` and fill in values:
#   cp .env.example .env
#
# `infra/.env` is gitignored and must never be committed.

# Password for the `postgres` superuser.
POSTGRES_PASSWORD=change-me

# Optional: override user/db (defaults shown). Only needed if you changed them.
POSTGRES_USER=postgres
POSTGRES_DB=postgres
